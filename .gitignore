# ==========================================
# Unity .gitignore
# ==========================================

# ---------- Library (regenerada automáticamente) ----------
[Ll]ibrary/

# ---------- Temp / Logs ----------
[Tt]emp/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# ---------- Build outputs ----------
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Oo]bj/
[Vv]alidationData/

# ---------- Archivos de Visual Studio / Rider / VS Code ----------
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- Unity generated ----------
*.apk
*.aab
*.unitypackage
*.app

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Captures de profiling ----------
*.psd
*.unity
